{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "ticketNumber": {
      "type": "number",
      "description": "Sequential ticket id"
    },
    "drawNumber": {
      "type": "number"
    },
    "userId": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "numbers": {
      "type": "string",
      "description": "Normalized 04-08-17-22-39"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "WINNING",
        "SETTLED",
        "EXPIRED"
      ],
      "default": "ACTIVE"
    },
    "agentCode": {
      "type": "string",
      "description": "Referral code attributed at purchase (empty if none)"
    },
    "price": {
      "type": "number",
      "default": 1
    },
    "charityContribution": {
      "type": "number",
      "default": 0
    },
    "prizeContribution": {
      "type": "number",
      "default": 0
    },
    "platformFee": {
      "type": "number",
      "default": 0
    },
    "agentReferral": {
      "type": "number",
      "default": 0
    },
    "govEarned": {
      "type": "number",
      "default": 1
    },
    "prizeTier": {
      "type": "string",
      "enum": [
        "5/5",
        "4/5",
        "3/5",
        "none"
      ],
      "default": "none"
    },
    "prizeAmount": {
      "type": "number",
      "default": 0
    },
    "agentBonusDeducted": {
      "type": "number",
      "default": 0,
      "description": "Winning Agent Bonus carved from this ticket's share"
    },
    "quickPick": {
      "type": "boolean",
      "default": false
    },
    "serialNumber": {
      "type": "string",
      "description": "Unique public ticket serial (e.g. CHARI-14-00007-A3F9). Used for email/QR/audit and printed on the ticket."
    },
    "recipientEmail": {
      "type": "string",
      "description": "For agent-on-behalf purchases: the email of the user the ticket was bought for."
    },
    "purchasedByAgentId": {
      "type": "string",
      "description": "Agent who paid for the ticket on behalf of the recipient (null for normal self-purchases)."
    },
    "purchasedByAgentEmail": {
      "type": "string",
      "description": "Email of the agent who paid for this ticket on behalf of the recipient."
    },
    "agentPurchase": {
      "type": "boolean",
      "default": false,
      "description": "True when an agent bought this ticket on behalf of another user."
    },
    "purchasedAt": {
      "type": "string",
      "description": "ISO timestamp of the agent-on-behalf purchase."
    },
    "createdAt": {
      "type": "string"
    }
  },
  "required": [
    "drawNumber",
    "numbers",
    "status"
  ]
}