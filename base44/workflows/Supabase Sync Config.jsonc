{
  "description": "Mirror ConfigParameter records (Admin Command Center) to Supabase (rotary_config) on create/update",
  "name": "Supabase Sync Config",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "ConfigParameter"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "supabase_sync_config",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "supabaseSync",
            "args": {
              "entity": "ConfigParameter",
              "recordId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Mirror config to Supabase",
            "description": "rotary_config"
          }
        }
      }
    ]
  }
}