{
  "description": "Mirror Draw records (Admin Command Center) to Supabase (rotary_draws) on create/update",
  "name": "Supabase Sync Draws",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Draw"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "supabase_sync_draws",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "supabaseSync",
            "args": {
              "entity": "Draw",
              "recordId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Mirror draw to Supabase",
            "description": "rotary_draws"
          }
        }
      }
    ]
  }
}