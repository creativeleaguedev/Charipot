{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Africa/Nairobi",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily sweep that burns expired ticket passes and sends day-before-expiry reminder emails to users.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pass_expiry_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processPassExpiry"
          },
          "then": "end",
          "x-base44": {
            "title": "Sweep expired passes",
            "description": "Burn expired + send reminders"
          }
        }
      }
    ]
  },
  "name": "Pass Expiry Sweep"
}